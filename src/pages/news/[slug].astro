---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const news = await getCollection("news");

    return news.map((item) => ({
        params: {
            slug: item.id,
        },
        props: {
            item,
        },
    }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---
<Layout title={`${item.data.title} | Ryan Fu`}>
    <article class="news-detail">
        <header>
            <h1>
                {item.data.title}
            </h1>
            <div class="news-meta">
                <span>{item.data.date}</span>
                {
                    item.data.location && (
                        <>
                            <span class="separator">·</span>
                            <span>{item.data.location}</span>
                        </>
                    )
                }
            </div>
        </header>
        <div class="news-content">
            <Content />
        </div>
        {
            item.data.related_project && (
                <div class="related">
                    <a href={`/portfolio/${item.data.related_project}`}>
                        Related Project →
                    </a>
                </div>
            )
        }
        {
            item.data.external_link && (
                <div class="external">
                    <a
                        href={item.data.external_link}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        External Link →
                    </a>
                </div>
            )
        }

    </article>
</Layout>

<style>
    /* =========================
       Header
       ========================= */
    .news-detail {
        max-width: 800px;
        margin-top: 6rem;
    }
    header {
        margin-bottom: 4rem;
    }
    .news-date {
        font-size: 1rem;
        color: var(--text-muted);
    }
    header h1 {
        margin: 0;
        font-size: 3.5rem;
        font-weight: 300;
        letter-spacing: 0;
        color: var(--text-primary);
    }
    .news-meta {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-top: 1.5rem;
        font-size: 1.15rem;
        color: var(--text-secondary);
    }
    .separator {
        color: var(--text-secondary);
    }
    /* =========================
       Content
       ========================= */
    .news-content {
        font-size: 1.15rem;
        line-height: 1.9;
    }
    .news-content p {
        margin-bottom: 1.5rem;
    }
    .news-content h2 {
        margin-top: 3rem;
        margin-bottom: 1rem;
    }
    .related,
    .external {
        margin-top: 3rem;
    }
    .related a,
    .external a {
        color: var(--accent);
    }
    @media (max-width: 768px) {
        header h1 {
            font-size: 2.5rem;
        }
    }
</style>