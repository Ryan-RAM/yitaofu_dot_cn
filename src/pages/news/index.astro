---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const news = await getCollection("news");

const sortedNews = news.sort((a, b) =>
    b.data.date.localeCompare(a.data.date)
);
---

<Layout title="News | Ryan Fu">
    <section class="news">
        <h1>
            News
        </h1>
        <div class="h1-note">
            Updates, events and recent activities.
        </div>
        <div class="news-list">
            {
                sortedNews.map((item) => (
                    <article class="news-item">
                        <div class="news-date">
                            {item.data.date}
                        </div>
                        <div class="news-information">
                            <a href={`/news/${item.id}`}>
                                <h2>
                                    {item.data.title}
                                </h2>
                            </a>
                            {
                                item.data.location && (
                                    <div class="news-location">
                                        {item.data.location}
                                    </div>
                                )
                            }
                        </div>
                    </article>
                ))
            }
        </div>
    </section>
</Layout>

<style>
    .news {
        max-width: 100%;
    }
    .news-list {
        margin-top: 5rem;
    }
    .news-item {
        display: grid;
        grid-template-columns: 180px 1fr;
        gap: 4rem;
        padding: 2rem 0;
        border-top: 1px solid #333;
    }
    .news-item:last-child {
        border-bottom: 1px solid #333;
    }
    .news-date {
        font-size: 1rem;
        color: var(--text-muted);
    }
    .news-information h2 {
        margin: 0;
        font-size: 1.7rem;
        font-weight: 300;
    }
    .news-information a {
        color: inherit;
        text-decoration: none;
    }
    .news-location {
        margin-top: 0.75rem;
        font-size: 1rem;
        color: var(--text-secondary);
    }
    @media (max-width: 768px) {
        .news-item {
            grid-template-columns: 1fr;
            gap: 0.5rem;
        }
    }
</style>