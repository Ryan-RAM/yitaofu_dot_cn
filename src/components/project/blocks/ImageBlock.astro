---
const {
    src,
    caption
}=Astro.props;
---
<section class="image-block">
    <figure>
        <img 
            src={src}
            alt={caption || ""}
        />
        {
            caption &&
            <figcaption>
                {caption}
            </figcaption>
        }
    </figure>
</section>

<style>
    .image-block{
        margin:5rem 0;
    }
    figure{
        margin:0;
    }
    img{
        width:100%;
        display:block;
    }
    figcaption{
        margin-top:1rem;
        font-size:1.15rem;
        letter-spacing:0.1em;
        margin-bottom:2rem;
        color:var(--text-muted);
    }
</style>